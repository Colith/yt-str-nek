// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Las URLs de conexión ya no van aquí: la de las migraciones está en
// prisma.config.ts y la de ejecución en lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @default(cuid())
  username  String      @unique
  password  String
  role      String      @default("mod")
  // Volumen con el que le gusta escuchar al usuario, de 0 a 100.
  // Null significa que todavia no ha elegido ninguno.
  volume    Int?
  // Fondo de la interfaz que prefiere el usuario: "normal" o "otaku".
  artStyle  String      @default("normal")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  addedBy   QueueItem[] @relation("AddedByUser")
  // Solo se usan si el usuario es streamer: su cola y lo que ya sonó en ella.
  queue     QueueItem[]   @relation("StreamerQueue")
  history   HistoryItem[] @relation("StreamerHistory")
  // Foto de perfil, si la ha subido. Va en su propia tabla para que las
  // consultas de usuario no arrastren la imagen.
  avatar    Avatar?      @relation("UserAvatar")
}

// La foto de perfil del usuario.
//
// Se guarda en la base de datos y no en un fichero porque la aplicación se
// despliega en Vercel, donde el disco es temporal: una foto subida a
// public/ se perdería en el siguiente despliegue. La imagen llega ya
// recortada a 256x256 desde el navegador, así que ocupa unos pocos KiB.
model Avatar {
  userId    String   @id
  data      Bytes
  // Tipo real de la imagen: "image/png", "image/jpeg" o "image/webp".
  type      String
  updatedAt DateTime @updatedAt
  user      User     @relation("UserAvatar", fields: [userId], references: [id], onDelete: Cascade)
}

model Song {
  id           String        @id @default(cuid())
  youtubeId    String        @unique
  title        String
  channel      String
  thumbnail    String
  durationSec  Int?
  createdAt    DateTime      @default(now())
  queueItems   QueueItem[]
  historyItems HistoryItem[]
}

model QueueItem {
  id            String   @id @default(cuid())
  position      Int
  requesterName String?
  addedById     String?
  addedBy       User?    @relation("AddedByUser", fields: [addedById], references: [id])
  songId        String
  song          Song     @relation(fields: [songId], references: [id])
  // Dueño de la cola. Cada streamer tiene la suya, con sus propias posiciones.
  streamerId    String
  streamer      User     @relation("StreamerQueue", fields: [streamerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  playedAt      DateTime?

  @@index([streamerId, position])
}

model HistoryItem {
  id            String   @id @default(cuid())
  requesterName String?
  addedById     String?
  addedByName   String?
  songId        String
  song          Song     @relation(fields: [songId], references: [id])
  streamerId    String
  streamer      User     @relation("StreamerHistory", fields: [streamerId], references: [id], onDelete: Cascade)
  playedAt      DateTime @default(now())

  @@index([streamerId, playedAt])
}
